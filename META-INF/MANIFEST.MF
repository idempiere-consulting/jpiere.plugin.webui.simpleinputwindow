Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: jpiere.plugin.webui.simpleinputwindow
Bundle-SymbolicName: jpiere.plugin.webui.simpleinputwindow;singleton:=true
Bundle-Version: 10.0.0.qualifier
Bundle-Vendor: OSS ERP Solutions
Bundle-ActivationPolicy: lazy
Require-Bundle: org.adempiere.base,
 org.adempiere.plugin.utils,
 org.adempiere.ui.zk,
 org.adempiere.ui,
 org.idempiere.zk.extra,
 zk,
 zkbind,
 zkplus,
 zcommon,
 zul,
 zhtml,
 zweb
Service-Component: OSGI-INF/jpierePluginSimpleInputWindowModelFactory.xml,OSGI-INF/jpierePluginSimpleInputWindowFormFactory.xml,OSGI-INF/jpierePluginSimpleInputWindowCalloutFactory.xml,
 OSGI-INF/jpierePluginSimpleInputWindowProcessFactory.xml
Export-Package: jpiere.plugin.simpleinputwindow.base,
 jpiere.plugin.simpleinputwindow.form,
 jpiere.plugin.simpleinputwindow.model
Import-Package: org.slf4j;version="1.7.2",
 org.slf4j.helpers;version="1.7.2",
 org.slf4j.spi;version="1.7.2"
Automatic-Module-Name: jpiere.plugin.webui.simpleinputwindow
Bundle-RequiredExecutionEnvironment: JavaSE-11
